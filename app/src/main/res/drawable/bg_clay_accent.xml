<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main base -->
    <item>
        <shape>
            <solid android:color="@color/sky_blue" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Light inner shadow (top) -->
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="2dp">
        <shape>
            <solid android:color="#4DFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Dark inner shadow (bottom) -->
    <item android:bottom="2dp" android:left="6dp" android:right="6dp" android:top="6dp">
        <shape>
            <solid android:color="#33000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
