<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/white_20">
    <item>
        <layer-list>
            <!-- Light shadow (top left) -->
            <item android:bottom="2dp" android:right="2dp">
                <shape>
                    <solid android:color="#263B82F6" /> <!-- Semi-transparent sky blue -->
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Dark shadow (bottom right) -->
            <item android:left="2dp" android:top="2dp">
                <shape>
                    <solid android:color="#4D000000" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Surface -->
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape>
                    <gradient
                        android:angle="135"
                        android:endColor="@color/sky_blue"
                        android:startColor="@color/royal_blue" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
